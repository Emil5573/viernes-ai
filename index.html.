
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#070b14">
<title>VIERNES AI</title>
<style>
:root {
  color-scheme: dark;
  --bg: #070b14;
  --panel: #101827;
  --cyan: #50e6ff;
  --text: #edf7ff;
  --muted: #8da5bb;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(ellipse at top, #142b43, var(--bg) 65%);
  color: var(--text);
  font: 16px system-ui, sans-serif;
}
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px;
  border-bottom: 1px solid #23374b;
}
.logo { color: var(--cyan); font-weight: 800; letter-spacing: 4px; }
.status { color: #8af7c6; font-size: 12px; }
main {
  max-width: 760px;
  margin: auto;
  padding: 24px 16px;
}
.core {
  text-align: center;
  padding: 18px 0 26px;
}
.orb {
  margin: 0 auto 18px;
  width: 112px;
  height: 112px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  border: 2px solid var(--cyan);
  box-shadow: 0 0 25px #27dfff55, inset 0 0 24px #27dfff22;
  color: var(--cyan);
  font-size: 42px;
}
h1 { margin: 8px 0; letter-spacing: 5px; }
p { color: var(--muted); }
.panel {
  background: #0e1725eF;
  border: 1px solid #263c50;
  border-radius: 18px;
  overflow: hidden;
}
#chat {
  height: min(42vh, 370px);
  min-height: 230px;
  overflow-y: auto;
  padding: 16px;
}
.message {
  padding: 12px 14px;
  margin: 10px 0;
  border-radius: 14px;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.bot {
  background: #16283a;
  border-left: 2px solid var(--cyan);
  margin-right: 12%;
}
.user {
  background: #123b4c;
  margin-left: 12%;
}
.controls {
  display: flex;
  gap: 8px;
  padding: 12px;
  border-top: 1px solid #263c50;
}
input {
  flex: 1;
  min-width: 0;
  padding: 13px;
  border-radius: 12px;
  border: 1px solid #344b60;
  background: #080f1a;
  color: white;
  font: inherit;
}
button {
  border: 1px solid #31556a;
  border-radius: 12px;
  padding: 12px 14px;
  color: var(--cyan);
  background: #132638;
  font: inherit;
  cursor: pointer;
}
button:active { background: #24506a; }
.features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
  margin-top: 14px;
}
.feature {
  border: 1px solid #263c50;
  background: #0d1623;
  padding: 13px 8px;
  border-radius: 12px;
  text-align: center;
  font-size: 13px;
}
.feature span {
  display: block;
  color: var(--cyan);
  font-size: 20px;
  margin-bottom: 5px;
}
footer {
  text-align: center;
  font-size: 12px;
  padding: 22px;
  color: var(--muted);
}
@media(max-width: 420px) {
  header { padding: 16px 12px; }
  main { padding: 16px 10px; }
  .controls { gap: 6px; padding: 8px; }
  button { padding: 11px 10px; }
}
</style>
</head>
<body>
<header>
  <div class="logo">V.I.E.R.N.E.S.</div>
  <div class="status">● SISTEMA INICIAL</div>
</header>

<main>
  <section class="core">
    <div class="orb">✳</div>
    <h1>VIERNES</h1>
    <p>Tu asistente personal. Siempre listo para ayudarte.</p>
  </section>

  <section class="panel">
    <div id="chat" aria-live="polite">
      <div class="message bot">
        Hola. Soy VIERNES, tu asistente personal.
        Mi interfaz está en línea. ¿Qué hacemos hoy?
      </div>
    </div>
    <form class="controls" id="form">
      <input id="input" placeholder="Escribe un mensaje..."
        autocomplete="off" aria-label="Tu mensaje">
      <button type="button" id="mic" aria-label="Hablar">🎙️</button>
      <button type="submit">➤</button>
    </form>
  </section>

  <section class="features">
    <div class="feature"><span>◉</span>Conversación</div>
    <div class="feature"><span>♫</span>Voz experimental</div>
    <div class="feature"><span>◇</span>Memoria futura</div>
  </section>
  <footer>
    PROTOTIPO 1.0 · La inteligencia artificial aún no está conectada.
  </footer>
</main>

<script>
const chat = document.getElementById("chat");
const input = document.getElementById("input");
const form = document.getElementById("form");

function addMessage(text, who) {
  const el = document.createElement("div");
  el.className = "message " + who;
  el.textContent = text;
  chat.appendChild(el);
  chat.scrollTop = chat.scrollHeight;
}

function viernesReply(text) {
  const q = text.toLowerCase();

  if (q.includes("hola")) {
    return "Hola. Estoy aquí. ¿En qué puedo ayudarte?";
  }
  if (q.includes("cómo te llamas")) {
    return "Mi nombre es VIERNES, tu asistente personal.";
  }
  if (q.includes("qué puedes hacer")) {
    return "Esta es mi primera versión. Pronto podremos conectar un modelo de IA, voz y memoria.";
  }
  if (q.includes("hora") || q.includes("fecha")) {
    return "Puedes consultar la fecha y hora de tu dispositivo. Más adelante integraré herramientas para ello.";
  }
  return "He recibido tu mensaje. Todavía estoy en modo de demostración; cuando conectemos un modelo de IA podré responder de forma inteligente.";
}

form.addEventListener("submit", (event) => {
  event.preventDefault();
  const text = input.value.trim();
  if (!text) return;
  addMessage(text, "user");
  input.value = "";

  const reply = viernesReply(text);
  addMessage(reply, "bot");

  if ("speechSynthesis" in window) {
    speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(reply);
    utterance.lang = "es-MX";
    speechSynthesis.speak(utterance);
  }
});

document.getElementById("mic").addEventListener("click", () => {
  const Recognition = window.SpeechRecognition ||
                     window.webkitSpeechRecognition;

  if (!Recognition) {
    addMessage("Este navegador no ofrece reconocimiento de voz compatible. Puedes escribir tu mensaje.", "bot");
    return;
  }

  const recognition = new Recognition();
  recognition.lang = "es-MX";
  recognition.onresult = (event) => {
    input.value = event.results[0][0].transcript;
    input.focus();
  };
  recognition.onerror = () => {
    addMessage("No pude reconocer la voz. Comprueba los permisos del micrófono o escribe tu mensaje.", "bot");
  };
  recognition.start();
});
</script>
</body>
</html>
